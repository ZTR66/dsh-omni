{
  "name": "@ztr66/dsh-omni",
  "version": "0.1.8",
  "description": "One plugin for every modality: probe, transcribe, analyse and compose image, video and audio.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "multimodal",
    "video",
    "audio",
    "image",
    "ffmpeg",
    "transcribe",
    "whisper",
    "storyboard"
  ],
  "license": "MIT",
  "author": "ZTR66",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZTR66/dsh-omni.git"
  },
  "bugs": {
    "url": "https://github.com/ZTR66/dsh-omni/issues"
  },
  "homepage": "https://github.com/ZTR66/dsh-omni#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
